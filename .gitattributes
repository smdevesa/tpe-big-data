# Normaliza finales de línea en texto; el resto se trata byte a byte.
* text=auto

# Los datos crudos de Landing son inmutables: Git no debe tocarlos (ni convertir CRLF/LF).
datalake/landing/** -text

# Scripts: finales de línea según donde se ejecutan
*.sh    text eol=lf
*.ps1   text eol=crlf

# Binarios
*.png   binary
*.pdf   binary
*.otf   binary
*.ttf   binary
*.parquet binary
