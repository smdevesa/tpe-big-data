%% Cloud Provider Analytics — Arquitectura propuesta (Primera entrega, v1)
%% Transcripción editable del diagrama draw.io (img/arquitectura-v1.png)
flowchart LR
    csv["Fuentes CSV<br/>Clientes, usuarios, recursos,<br/>soporte, marketing, NPS y facturación"]
    jsonl["Eventos JSONL<br/>Uso de servicios<br/>Micro-lotes simulados"]

    subgraph DL["DATA LAKE"]
        landing["Landing<br/>Originales sin modificar"]
        batch["Batch<br/>PySpark"]
        stream["Streaming<br/>Structured Streaming"]
        bronze["Bronze<br/>Parquet y tipos definidos"]
        silver["Silver<br/>Normalización y calidad"]
        gold["Gold<br/>Indicadores de negocio"]
        landing --> batch --> bronze
        landing --> stream --> bronze
        bronze --> silver --> gold
    end

    cass["Cassandra / AstraDB<br/>Tablas para consultas"]
    consumo["Consumo<br/>Consultas y visualizaciones<br/>FinOps · Soporte · Producto"]

    csv --> landing
    jsonl --> landing
    gold --> cass --> consumo

    transv["En todo el recorrido: gobierno · calidad · seguridad · metadatos y trazabilidad · observabilidad"]
    DL ~~~ transv
